# Only our own code, the benchmark report and its figures are versioned.
# Everything that is downloaded, built or produced by a run stays out (README, "Install").
/vendor/
/tools/
/data/
/db/
/models/
/.venv
/runs/
/logs/
/docs/
/Papers/
/research/
/.research-deps/
__pycache__/
*.egg-info/
*.out

# benchmark: scripts, report and PNG figures are versioned; the inputs and outputs of a run are not
/benchmark/*
!/benchmark/*.py
!/benchmark/REPORT.md
!/benchmark/figures/
/benchmark/figures/*.pdf
